NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Usada só no servidor (rota /api/webhook/stripe) para escrever em
# `subscriptions` sem depender da sessão do usuário. Pegue em
# Project Settings > API > service_role no Supabase. Nunca exponha essa
# chave com o prefixo NEXT_PUBLIC_ nem no client.
SUPABASE_SERVICE_ROLE_KEY=

# Usada só no servidor (rota /api/generate-itinerary-ai) para a IA que
# organiza roteiros já montados pelo usuário. Nunca exponha essa chave com
# o prefixo NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Stripe (checkout dos planos pagos). Chaves de teste em
# https://dashboard.stripe.com/test/apikeys.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Gerado ao rodar `stripe listen --forward-to localhost:3000/api/webhook/stripe`
# em desenvolvimento, ou ao criar o endpoint de produção no dashboard.
STRIPE_WEBHOOK_SECRET=

# Afiliados — deixe em branco até criar a conta no programa; o componente
# AffiliateCallout esconde o link de qualquer programa sem ID configurado.
NEXT_PUBLIC_BOOKING_AFFILIATE_ID=
NEXT_PUBLIC_GETYOURGUIDE_PARTNER_ID=
